# 환경 변수 이름 목록 — 값은 넣지 않는다. (PLAN 작업 17)
# 이 파일을 복사해 `.env`로 저장하고 값을 채운다. `.env`는 .gitignore에 등록되어 GitHub에 올라가지 않는다.
# 비밀 값을 이 파일에 적지 않는다. 이 파일은 GitHub에 올라간다.
# 이름 앞에 NEXT_PUBLIC_을 붙이지 않는다 (붙이면 브라우저에 노출된다).

# [필수 · 서버 전용] 말로 입력한 조건을 해석하는 OpenAI 키.
# 없으면 앱은 켜지지만 "AI 조건 입력을 지금 쓸 수 없어요"가 나오고, 기본 조건 실행과 엑셀은 계속 된다.
# 배포(Vercel)에서는 환경변수 설정 화면에도 같은 이름으로 등록한다.
OPENAI_API_KEY=

# [필수 · 서버 전용] 필지 데이터가 들어 있는 데이터베이스(Supabase) 접속 주소.
# 형태: postgresql://사용자:비밀번호@주소:6543/postgres (Supabase의 "Transaction pooler" 주소)
# 비밀번호가 들어 있으므로 절대 올리지 않는다. 없으면 선별·엑셀이 동작하지 않고, 배포(Vercel) 빌드는 멈춘다.
# 배포(Vercel)에서는 환경변수 설정 화면에도 같은 이름으로 등록한다.
DATABASE_URL=

# [개발용] Supabase 작업용. 프로젝트 만들기·관리에 Supabase CLI가 .env에서 읽는다. 앱 코드는 쓰지 않는다.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# [선택 · 개발 전용] 브이월드 공식 API 키. 공식 자료와 대조하는 정확도 확인(npm run eval:external)에만 쓴다.
# 지금 앱 화면·서버는 쓰지 않으므로 배포에는 필요 없다. (나중에 브이월드 API를 앱에 연결할 때 쓴다)
VWORLD_API_KEY=

# [배포용] Vercel CLI로 배포할 때 .env에서 읽는다 (Part 5). 앱 코드는 쓰지 않는다.
VERCEL_TOKEN=
